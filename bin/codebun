#!/usr/bin/env bash
# Codebun launcher: the VS Code distribution's own policy, in one place.
#
#   bin/codebun [--folder <path>] [--open-folder] [--port N] [--reh] [-- vshell args]
#
# Everything VS Code-shaped lives here or in the files this script points at. The
# shell it drives (vshell) only knows about a window, an HTTP/WS origin, native
# menus and injected payloads:
#
#   --inject   the session token + folder, opaque to the shell
#   --script   integration/bridge.js, which gives that payload its meaning
#   --menu     integration/menu.json, the native bar in VS Code's vocabulary
#   --backend  server/backend.js, the shell's HTTP plugin slot: FS provider, PTY
#              terminal, and the rendered workbench host page
#
# Two ways to get a workbench, both driven by this one script:
#
#   default    serve the static web build out of web/public (stage/build_web.sh).
#              The web extension host runs in a worker, so codebun-backend — a
#              browser extension — loads and the folder/terminal work end to end.
#   --reh      run the REH (stage/build_reh.sh) as a child and let the shell front
#              it: --proxy makes the shell the ORIGIN and forwards, because the
#              REH's own WebSocket does not survive every engine. The shell
#              terminates it and pipes frames instead (vshell/web/proxy.js).
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

# --- toolchain ---------------------------------------------------------------
for candidate in "${BUN_BIN_DIR:-}" "${HOME:-}/.bun/bin" "/c/Users/${USER:-}/.bun/bin" "/c/Users/Lenovo/.bun/bin"; do
	case "${candidate}" in
		"" | "/.bun/bin" | "/c/Users//.bun/bin") continue ;;
	esac
	if [ -x "${candidate}/bun" ] || [ -x "${candidate}/bun.exe" ]; then
		PATH="${candidate}:${PATH}"
		export PATH
		break
	fi
done
if ! command -v bun >/dev/null 2>&1; then
	echo "ERROR: 'bun' not found in PATH (tried BUN_BIN_DIR, \$HOME/.bun/bin)." >&2
	exit 1
fi

VSHELL_BIN="${VSHELL_BIN:-}"
if [ "$VSHELL_BIN" = "" ]; then
	# Sibling layout first (two repos side by side), then a nested clone, which is
	# how this tree happens to be laid out during development.
	for candidate in "$HERE/../vshell/bin/vshell.exe" "$HERE/vshell/bin/vshell.exe"; do
		if [ -x "$candidate" ]; then
			VSHELL_BIN="$candidate"
			break
		fi
	done
fi
if [ ! -x "$VSHELL_BIN" ]; then
	echo "ERROR: no shell at ${VSHELL_BIN:-<not found>}" >&2
	echo "       build it: sh ../vshell/scripts/build_vshell.sh" >&2
	echo "       or point VSHELL_BIN at one." >&2
	exit 1
fi

# --- arguments ---------------------------------------------------------------
port=8123
reh_port=8137
folder=""
open_folder=0
mode=web
extra=()
while [ $# -gt 0 ]; do
	case "$1" in
		--folder) folder="${2:?--folder needs a path}"; shift 2 ;;
		--open-folder) open_folder=1; shift ;;
		--port) port="${2:?--port needs a number}"; shift 2 ;;
		--reh-port) reh_port="${2:?--reh-port needs a number}"; shift 2 ;;
		--reh) mode=reh; shift ;;
		--) shift; extra+=("$@"); break ;;
		*) extra+=("$1"); shift ;;
	esac
done

REH="$HERE/.work/reh"
WEB="$HERE/web/public"
if [ "$mode" = "reh" ]; then
	if [ ! -f "$REH/out/server-main.js" ]; then
		echo "ERROR: no REH at $REH/out/server-main.js (build it: sh stage/build_reh.sh)" >&2
		exit 1
	fi
elif [ ! -f "$WEB/out/vs/code/browser/workbench/workbench.html" ]; then
	echo "ERROR: no web build at $WEB (build it: sh stage/build_web.sh)" >&2
	echo "       or run the REH flow instead: bin/codebun --reh" >&2
	exit 1
fi

# --- session -----------------------------------------------------------------
# A fresh token per run: the backend service rejects anything without it, and the
# page only ever learns it from the shell's injected script (never over HTTP).
CODEBUN_TOKEN="$(bun -e 'process.stdout.write(crypto.randomUUID().replace(/-/g, ""))')"
export CODEBUN_TOKEN

args=(
	--engine webkit
	--port "$port"
	--inject "{\"token\":\"$CODEBUN_TOKEN\"}"
	--script "$HERE/integration/bridge.js"
	--menu "@$HERE/integration/menu.json"
	--backend "$HERE/server/backend.js"
)

if [ "$mode" = "reh" ]; then
	mkdir -p "$HERE/.work/reh-data"
	args+=(
		--run bun
		--run-arg "$REH/out/server-main.js"
		--run-arg --host --run-arg 127.0.0.1
		--run-arg --port --run-arg "$reh_port"
		--run-arg --without-connection-token
		--run-arg --accept-server-license-terms
		--run-arg --server-data-dir --run-arg "$HERE/.work/reh-data"
		--proxy "http://127.0.0.1:${reh_port}/"
	)
else
	args+=(--serve "$WEB")
fi

if [ "$open_folder" = "1" ]; then
	args+=(--open-folder)
fi
if [ "$folder" != "" ]; then
	args+=(--folder "$folder")
fi

echo "==> codebun ($mode) $VSHELL_BIN"
exec "$VSHELL_BIN" "${args[@]}" "${extra[@]}"
